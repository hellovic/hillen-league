    "verify": "npm run build && node scripts/verify.mjs",
    "verify:site": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.4"
  },
  "description": "Hillen Youth League dashboard — React port of the “Courtside Orange” design system"
}
